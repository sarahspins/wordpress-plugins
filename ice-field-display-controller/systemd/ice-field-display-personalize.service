[Unit]
Description=Personalize an Ice & Field cloned display node
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service systemd-networkd.service ssh.service tailscaled.service lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ice-field-personalize-node --first-boot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=5min

[Install]
WantedBy=sysinit.target
